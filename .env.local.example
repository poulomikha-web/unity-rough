# Supabase — the "Unity Rough" account/project that stores the unity_rough module.
# Copy this file to .env.local and fill in the two values from:
#   Supabase dashboard -> Project Settings -> API
# Both are safe to expose in the browser (public, client-side keys).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Optional TURN relay for the agent call — needed when the customer or agent is
# on mobile data / carrier NAT (direct WebRTC fails there). Free tiers: Metered
# (metered.ca), ExpressTURN, Cloudflare Realtime TURN. Comma-separate the URLs.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
