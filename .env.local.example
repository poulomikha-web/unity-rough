# Supabase — the "Unity Rough" account/project that stores the unity_rough module.
# Copy this file to .env.local and fill in the two values from:
#   Supabase dashboard -> Project Settings -> API
# Both are safe to expose in the browser (public, client-side keys).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
